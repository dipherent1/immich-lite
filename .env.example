# Immich Lite — environment template.
# Copy to `.env` and fill in values. `.env` is gitignored; this file is a template only.

# --- Auth (REQUIRED outside dev) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
# JWT_ALGORITHM=HS256
# JWT_EXPIRES_MINUTES=10080

# --- Backing services (local dev defaults; compose overrides these) ---
# DATABASE_URL=postgresql+psycopg2://immich:immich@localhost:5433/immich_lite
# QDRANT_URL=http://localhost:8090
# REDIS_URL=redis://localhost:6379/0

# --- ML / ingestion ---
# MODEL_NAME=buffalo_s
# DETECTION_THRESHOLD=0.5
# SIMILARITY_THRESHOLD=0.5
# OUTPUT_ROOT=output

# --- API ---
# CORS_ORIGINS=http://localhost:3000

# --- Logging ---
# LOG_LEVEL=INFO
# LOG_FILE=logs/app.log

# --- Worker ---
# WORKER_METRICS_PORT=9100

# --- Grafana (compose interpolation) ---
GRAFANA_ADMIN_PASSWORD=admin