# ==============================================================================
# Immich Lite — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and fill in values before starting containers.
# `.env` is gitignored. NEVER commit production credentials to Git.

# --- Required Security / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-secure-random-secret
# JWT_ALGORITHM=HS256
# JWT_EXPIRES_MINUTES=10080

# --- PostgreSQL Database Credentials ---
POSTGRES_USER=immich_admin
POSTGRES_PASSWORD=change-me-to-a-strong-database-password
POSTGRES_DB=immich_lite

# --- RabbitMQ Message Broker Credentials ---
RABBITMQ_DEFAULT_USER=immich_rabbit
RABBITMQ_DEFAULT_PASS=change-me-to-a-strong-broker-password

# --- Machine Learning / Processing ---
# MODEL_NAME=buffalo_s
# CELERY_CONCURRENCY=1
# OUTPUT_ROOT=/app/output

# --- Frontend API Endpoint ---
# Leave empty for same-origin (/api/...) routing through Nginx reverse proxy.
# Set only if frontend is served on a separate origin or CDN.
NEXT_PUBLIC_API_URL=


# --- CORS Allowed Origins ---
# CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000

# --- Rate Limiting ---
# Redis is used as the shared counter store (required for multi-worker/multi-container deployments).
# The docker-compose stack starts Redis automatically — no manual setup needed.
# Override limits using the formats below (N/second | N/minute | N/hour).
# RATE_LIMIT_GLOBAL=150/minute   # Applied to every route per IP
# RATE_LIMIT_AUTH=10/minute      # Login + register (tighter — protects against brute force)

# --- Optional Monitoring Stack (docker-compose.monitoring.yml) ---
# Active only when running:
#   docker compose -f docker-compose.yml -f docker-compose.monitoring.yml --profile monitoring up -d
# Note: Prometheus & Grafana are deferred for initial deployment to reduce resource usage.

BESZEL_KEY=
BESZEL_TOKEN=
BESZEL_APP_URL=
# Event lifetime: events (and their photos) are deleted this many hours after creation.
# EVENT_LIFETIME_HOURS=6
# Attendees are notified this many minutes before deletion.
# EVENT_EXPIRY_WARNING_MINUTES=20
# How often the worker looks for events to warn about / delete.
# EVENT_SWEEP_INTERVAL_SECONDS=60
